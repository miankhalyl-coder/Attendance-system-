# ---- Vercel project environment variables (build-time; public values only) ----
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase > Project Settings > API > anon / publishable key   (NOT the service_role key)
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Pseudo-email domain used to map usernames to Auth emails. Must equal the Edge Function secret below.
EMAIL_DOMAIN=gpskg.app

# ---- Supabase Edge Function secrets (set with `supabase secrets set`, never in Vercel/GitHub) ----
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# EMAIL_DOMAIN=gpskg.app
# ALLOWED_ORIGIN=https://your-app.vercel.app
